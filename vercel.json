{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install --no-audit --no-fund",
  "crons": [
    {
      "path": "/api/cron/supply",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/control",
      "schedule": "0 8 * * *"
    }
  ]
}
